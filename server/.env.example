# คัดลอกไฟล์นี้เป็น server/.env แล้วใส่ key จริง (.env ห้าม commit — อยู่ใน .gitignore แล้ว)
# ไม่ใส่ key = Solo ใช้โหมดจำลอง (AI เดาสุ่มจากคลังคำ) ไม่เรียก Claude
ANTHROPIC_API_KEY=

# Firebase Authentication สำหรับ Google และอีเมล/รหัสผ่าน
# FIREBASE_API_KEY เป็น Web API key (ไม่ใช่รหัสผ่าน) ใช้ตรวจ ID token กับ Firebase
FIREBASE_API_KEY=
# สุ่มด้วย node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=

# ไม่บังคับ: รุ่นที่ใช้ทายภาพ (ค่าเริ่มต้น claude-haiku-4-5-20251001 เร็วและถูก)
# AI_MODEL=claude-haiku-4-5-20251001

# ไม่บังคับ — เก็บคะแนน Leaderboard ใน Upstash Redis แทนไฟล์ (ใช้ตอน deploy บน Render ที่ดิสก์หายเมื่อรีสตาร์ท)
# ไม่ใส่ = เก็บในไฟล์ server/data/scores.json เหมือนเดิม · ดูวิธีใน DEPLOY.md
# (ตอน deploy จริงให้ใส่ในหน้า Environment ของ Render ไม่ต้องใส่ในไฟล์นี้)
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
